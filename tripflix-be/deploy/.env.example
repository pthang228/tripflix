# Chép thành deploy/.env (không commit). docker compose tự đọc file này.

# Đổi cổng nếu máy đã có Postgres, Redis chạy sẵn
PG_PORT=5432
REDIS_PORT=6379
LOG_LEVEL=debug

# Đường dẫn tới 2 repo còn lại (mặc định: clone cạnh tripflix-be)
AI_REPO=../../tripflix-ai
FE_REPO=../../tripflix-fe

# Media dev: bucket S3 thật, mỗi người một thư mục dev/<tên>/ (xem deploy/aws/README.md)
DEV_NAME=trang
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=tripflix-media-dev
MEDIA_CDN_URL=

# ai-service
OPENAI_API_KEY=
