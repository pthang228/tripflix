{
  "name": "tripflix-fe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=./apps/web --filter=./apps/admin",
    "build": "turbo run build",
    "lint": "turbo run lint && node tools/check-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "gen:api": "pnpm --filter @tripflix/api-client gen"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
